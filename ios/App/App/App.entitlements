<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push (LT-129). Xcode flips this to "production" on archive. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal links (LT-128 §6): pairs with public/.well-known/apple-app-site-association. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:dashboard.lightor.app</string>
	</array>
</dict>
</plist>
