# Client-side build configuration for PRODUCTION builds (CI builds with no
# local .env). Everything here is baked into the public JS bundle by Vite, so
# nothing in this file is or may ever be a secret — server-side secrets live in
# the server .env, never in a VITE_ variable.
# Local development overrides belong in .env (gitignored).
VITE_CLIENT_APP_URL=https://preview.lightor.app
VITE_TURNSTILE_SITE_KEY=0x4AAAAAACymzPIQ6JSL9jPH
# Paddle: LIVE since 2026-10-13 (LT-296). A client-side token is public by design;
# the API key and the webhook secret live only in the server's .env.
VITE_PADDLE_CLIENT_TOKEN=live_75b4dd2f166b299756b84d1cf80
VITE_PADDLE_ENV=production
VITE_PADDLE_PRICE_ID_BASIC=pri_01m4v4d5nwxdccnyaatfa83aq6
VITE_PADDLE_PRICE_ID_ANNUAL=pri_01m4v4ggkwj24zrnq1gakjtcbk
VITE_GOOGLE_CLIENT_ID=705905319826-rpvog05a0sprnhhbame497rm4hs36ejl.apps.googleusercontent.com
VITE_FACEBOOK_APP_ID=2690947951349617
# Instagram Login (LT-043) — the Lightor Social app's Instagram app id (public, like the FB app id).
VITE_INSTAGRAM_APP_ID=2073855823517709

# Facebook/Instagram surfaces are hidden until Meta App Review approves
# user_photos and instagram_business_basic (LT-089/LT-091): the FB login
# button and both portfolio import tiles. Set to true and rebuild to bring
# them all back. Opt-in on purpose — absent or misspelled means hidden.
VITE_META_FEATURES_ENABLED=false
# Google Maps Platform browser key for address suggestions in the owner's
# manual booking (LT-206) — the same key as lightor-front's (LT-191). Public
# by design; protected by its restrictions in the Google Cloud console: HTTP
# referrers https://*.lightor.app/* and https://lightor.app/*, APIs Maps
# JavaScript + Places (New) only. No key = the plain text field.
VITE_GOOGLE_MAPS_KEY=AIzaSyD27WfMfIt6meY6aPNVuoK0gHdWh8tw4n8
# Sign in with Apple on the web (LT-383): the Services ID from the Apple Developer
# portal (Identifiers > Services IDs). Empty = no Apple button on the web; the
# iPhone app does not need it.
VITE_APPLE_SERVICES_ID=app.lightor.web
